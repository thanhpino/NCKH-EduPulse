# ===========================
# EduPulse Environment Config
# ===========================
# Copy this file to .env and fill in the values

# ---- General ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Registry Service ----
REGISTRY_PORT=3001
REGISTRY_MONGO_URI=mongodb://mongo-registry:27017/edupulse-registry

# ---- Traffic Shaping Gateway ----
GATEWAY_PORT=3002
GATEWAY_REDIS_URL=redis://redis-gateway:6379
GATEWAY_ADMISSION_RATE=50
GATEWAY_QUEUE_TTL=300

# ---- Probe Engine ----
PROBE_PORT=3003
PROBE_TIMESCALE_URL=postgres://probe:probe_pass@timescaledb:5432/edupulse_metrics
PROBE_INTERVAL_MS=5000
PROBE_BURST_INTERVAL_MS=1000

# ---- Capacity Advisor ----
ADVISOR_PORT=3004
ADVISOR_DB_URL=postgres://advisor:advisor_pass@postgres-advisor:5432/edupulse_advisor
ADVISOR_WINDOW_SIZE=30
ADVISOR_SLOPE_THRESHOLD=0.15

# ---- Alert Service ----
ALERT_PORT=3005
ALERT_MONGO_URI=mongodb://mongo-alert:27017/edupulse-alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---- Mock Backend ----
MOCK_PORT=3010
MOCK_MONGO_URI=mongodb://mongo-mock:27017/mock-registration
MOCK_MAX_CONNECTIONS=5
MOCK_LATENCY_BASE_MS=50

# ---- Dashboard ----
DASHBOARD_PORT=3000
VITE_API_BASE_URL=http://localhost:3002
